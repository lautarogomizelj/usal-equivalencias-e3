server:
  port: 8080
  servlet:
    context-path: /api

spring:
  application:
    name: e3-backend
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/e3}
    username: ${DB_USERNAME:e3}
    password: ${DB_PASSWORD:e3_dev}
  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: validate
  flyway:
    enabled: true
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 50MB

management:
  endpoints:
    web:
      exposure:
        include: health

springdoc:
  swagger-ui:
    path: /swagger-ui.html

e3:
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173}
