server:
  port: 8080
  servlet:
    context-path: /api

spring:
  application:
    name: e3-backend
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/e3}
    username: ${DB_USERNAME:e3}
    password: ${DB_PASSWORD:e3_dev}
  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: validate
  flyway:
    enabled: true
  jackson:
    time-zone: America/Argentina/Buenos_Aires
  mail:
    host: ${MAIL_HOST:localhost}
    port: ${MAIL_PORT:1025}
    username: ${MAIL_USERNAME:}
    password: ${MAIL_PASSWORD:}
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: ${GOOGLE_CLIENT_ID:sin-configurar}
            client-secret: ${GOOGLE_CLIENT_SECRET:sin-configurar}
            scope: openid,email,profile
            redirect-uri: "{baseUrl}/auth/google/callback"
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 50MB

management:
  endpoints:
    web:
      exposure:
        include: health
  health:
    mail:
      enabled: false

springdoc:
  swagger-ui:
    path: /swagger-ui.html

e3:
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:5273}
  frontend-url: ${FRONTEND_URL:http://localhost:5173}
  mail-remitente: ${MAIL_FROM:no-responder@usal.edu.ar}
  sesion:
    # Solo para desarrollo: en producción manda JWT_SECRET (application-prod.yml).
    jwt-secret: ${JWT_SECRET:e3-secreto-solo-para-desarrollo-local-0123456789}
    cookie-secure: false
  seed-demo: ${SEED_DEMO:false}
